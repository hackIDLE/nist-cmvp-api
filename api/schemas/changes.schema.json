{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackidle.github.io/nist-cmvp-api/api/schemas/changes.schema.json",
  "title": "NIST CMVP Changes Feed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "max_runs",
    "total_runs",
    "runs"
  ],
  "properties": {
    "metadata": {
      "$ref": "/api/schemas/metadata.schema.json"
    },
    "max_runs": {
      "type": "integer",
      "minimum": 1
    },
    "total_runs": {
      "type": "integer",
      "minimum": 0
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "generated_at",
          "added_active",
          "added_historical",
          "removed",
          "changed",
          "counts"
        ],
        "properties": {
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "added_active": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          },
          "added_historical": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          },
          "removed": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          },
          "changed": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          },
          "counts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "added_active",
              "added_historical",
              "removed",
              "changed"
            ],
            "properties": {
              "added_active": {
                "type": "integer",
                "minimum": 0
              },
              "added_historical": {
                "type": "integer",
                "minimum": 0
              },
              "removed": {
                "type": "integer",
                "minimum": 0
              },
              "changed": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}